# Local MongoDB is enabled for normal backend runs. Backend test commands override
# DATABASE_ENABLED to false because they intentionally do not require a database.
DATABASE_ENABLED=true

# Keep this URI local. Do not add credentials to this example or commit backend/.env.
DATABASE_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=179fc_mms_local

# Integer milliseconds from 100 to 60000. Startup fails safely after this timeout.
DATABASE_CONNECT_TIMEOUT_MS=5000
